# ── Database (Neon Postgres via Vercel Marketplace) ─────────────────────────
# Pooled connection for runtime. Injected automatically when the Neon
# integration is connected to the Vercel project.
DATABASE_URL=
# Direct (unpooled) connection — used ONLY by drizzle-kit migrations.
DATABASE_URL_UNPOOLED=

# ── Google OAuth client (Google Cloud console → APIs & Services → Credentials)
# One web client serves BOTH flows: better-auth sign-in AND Google Health consent.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Secrets (generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
# AES-256-GCM key for Google token encryption at rest. Losing it orphans all
# stored tokens (reconnect required). Environments sharing one Neon database
# MUST share this key; split keys make each environment unable to decrypt the
# other's token writes.
TOKEN_ENCRYPTION_KEY=
# better-auth signing secret.
BETTER_AUTH_SECRET=

# ── App URLs ─────────────────────────────────────────────────────────────────
# Local: http://localhost:3000 · Prod: https://<your-vercel-domain>
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Access control ───────────────────────────────────────────────────────────
# Comma-separated Google account emails allowed to sign in (MCP auth layer).
# Fails closed when empty. Each listed identity connects only its own Google
# Health data. Production membership is fixed by ADR-0001; there is no wildcard
# or empty-means-public mode.
ALLOWED_GOOGLE_EMAILS=

# ── v1.1 (webhooks) — leave empty until then ────────────────────────────────
GOOGLE_CLOUD_PROJECT_NUMBER=
GOOGLE_HEALTH_SUBSCRIBER_ID=
WEBHOOK_AUTH_SECRET=
